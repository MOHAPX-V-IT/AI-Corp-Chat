# Generate fresh local secrets with npm run setup; never commit .env.
APP_TITLE=AI Corp Chat
APP_ROOT=/app
SUPPLIER_ARTIFACTS_DIR=/app/uploads/supplier-artifacts
HOST=0.0.0.0
PORT=3080
WEB_PORT=3088
DOMAIN_CLIENT=http://localhost:3088
DOMAIN_SERVER=http://localhost:3088
TRUST_PROXY=1
NO_INDEX=true
CONFIG_PATH=/app/librechat.yaml
MONGO_PASSWORD=CHANGE_ME
MONGO_URI=mongodb://ai_corp:CHANGE_ME@mongodb:27017/ai_corp_chat?authSource=admin
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=CHANGE_ME
SEARCH=true
MEILI_NO_ANALYTICS=true
POSTGRES_DB=ai_corp
POSTGRES_USER=ai_corp
POSTGRES_PASSWORD=CHANGE_ME
DB_HOST=vectordb
DB_PORT=5432
DB_DATABASE=ai_corp
DB_USERNAME=ai_corp
DB_PASSWORD=CHANGE_ME
RAG_PORT=8000
RAG_API_URL=http://rag_api:8000
TOKEN_USAGE_DB_URL=postgresql://ai_corp:CHANGE_ME@vectordb:5432/ai_corp
TOKEN_USAGE_DOMAIN=ai-corp-chat
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
CREDS_KEY=CHANGE_ME
CREDS_IV=CHANGE_ME
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=CHANGE_ME
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
ALLOW_PASSWORD_RESET=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=false
SESSION_EXPIRY=900000
REFRESH_TOKEN_EXPIRY=604800000
# Set your own model credentials; no provider key is bundled.
CHAT_PROVIDER=DeepSeek
CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
CORP_INTERNAL_AI_PROVIDER=deepseek
# Visual PDF/market document reading needs Gemini or Vertex credentials.
GOOGLE_KEY=
GOOGLE_SERVICE_KEY_FILE=
GOOGLE_LOC=global
CORP_GEMINI_MODEL=gemini-3.5-flash
GOOGLE_MODELS=gemini-3.5-flash
# File-search embeddings require a supported provider.
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
OPENAI_API_KEY=
# Optional web search, speech and email integrations.
TAVILY_API_KEY=
SERPER_API_KEY=
FIRECRAWL_API_KEY=
JINA_API_KEY=
STT_API_KEY=
TTS_API_KEY=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=AI Corp Chat
DEBUG_LOGGING=false
DEBUG_CONSOLE=false
